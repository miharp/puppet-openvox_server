{
  "name": "miharp-openvox_server",
  "version": "0.1.1",
  "author": "Michael Harp",
  "summary": "Manages OpenVox Server: package, CA, configuration and service",
  "license": "Apache-2.0",
  "source": "https://github.com/miharp/puppet-openvox_server",
  "project_page": "https://github.com/miharp/puppet-openvox_server",
  "issues_url": "https://github.com/miharp/puppet-openvox_server/issues",
  "tags": [
    "openvox",
    "server",
    "puppetserver",
    "ca"
  ],
  "dependencies": [
    {
      "name": "miharp/openvox_agent",
      "version_requirement": ">= 0.2.0 < 1.0.0"
    },
    {
      "name": "miharp/openvox_tune",
      "version_requirement": ">= 0.1.0 < 1.0.0"
    },
    {
      "name": "puppetlabs/hocon",
      "version_requirement": ">= 2.0.0 < 3.0.0"
    },
    {
      "name": "puppetlabs/inifile",
      "version_requirement": ">= 6.0.0 < 7.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "12",
        "13"
      ]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "22.04",
        "24.04"
      ]
    },
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "Rocky",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "AlmaLinux",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "OracleLinux",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    }
  ],
  "requirements": [
    {
      "name": "openvox",
      "version_requirement": ">= 8.0.0 < 10.0.0"
    }
  ]
}
