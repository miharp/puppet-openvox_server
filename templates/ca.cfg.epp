<%- | Boolean $ca_enabled | -%>
# To enable the CA service, leave the following line uncommented
<%= $ca_enabled ? { true => '', default => '#' } %>puppetlabs.services.ca.certificate-authority-service/certificate-authority-service
# To disable the CA service, comment out the above line and uncomment the line below
<%= $ca_enabled ? { true => '#', default => '' } %>puppetlabs.services.ca.certificate-authority-disabled-service/certificate-authority-disabled-service
puppetlabs.trapperkeeper.services.watcher.filesystem-watch-service/filesystem-watch-service

