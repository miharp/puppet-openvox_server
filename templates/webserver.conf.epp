<%- | Hash[String[1], String[1]] $agent_ssl,
      Boolean $tls_termination,
      String[1] $host,
      Integer[1, 65535] $port,
      String[1] $ssl_host,
      Integer[1, 65535] $ssl_port,
      Enum['want', 'need', 'none'] $client_auth,
      String[1] $access_log_config,
      Hash[String[1], Variant[String, Numeric, Boolean, Array[Variant[String, Numeric, Boolean]]]] $extra_settings,
| -%>
# This file is managed by the openvox_server class; local changes are
# overwritten.
webserver: {
    access-log-config: <%= $access_log_config %>
<% if $tls_termination { -%>
    host: <%= $host %>
    port: <%= $port %>
<% } else { -%>
    client-auth: <%= $client_auth %>
    ssl-host: <%= $ssl_host %>
    ssl-port: <%= $ssl_port %>
<% $agent_ssl.each |$setting, $path| { -%>
    <%= $setting %>: <%= $path %>
<% } -%>
<% } -%>
<% $extra_settings.keys.sort.each |$setting| { -%>
    <%= $setting %>: <%= openvox_server::hocon_value($extra_settings[$setting]) %>
<% } -%>
}
